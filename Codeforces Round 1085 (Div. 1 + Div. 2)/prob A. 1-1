#include <bits/stdc++.h>
using namespace std;
 
int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        string s;
        cin >> n >> s;
        
        // First expand all 0s between 1s (merging blocks)
        string expanded = s;
        bool changed = true;
        while (changed) {
            changed = false;
            for (int i = 1; i < n-1; i++) {
                if (expanded[i] == '0' && expanded[i-1] == '1' && expanded[i+1] == '1') {
                    expanded[i] = '1';
                    changed = true;
                }
            }
        }
        
        // Max: count 1s in expanded
        int maxVal = (int)count(expanded.begin(), expanded.end(), '1');
        
        // Min: each contiguous block of k ones -> floor(k/2) + 1
        int minVal = 0;
        int i = 0;
        while (i < n) {
            if (expanded[i] == '1') {
                int k = 0;
                while (i < n && expanded[i] == '1') { k++; i++; }
                minVal += k / 2 + 1;
            } else {
                i++;
            }
        }
        
        cout << minVal << " " << maxVal << "\n";
    }
    return 0;
}
