#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    long long c, k;
    cin >> n >> c >> k;

    vector<long long> a(n);
    for (auto &x : a) cin >> x;

    sort(a.begin(), a.end());

    for (int i = 0; i < n; ++i) {
        if (c >= a[i]) {
            long long can_use = min(k, c - a[i]);
            k -= can_use;
            long long new_a = a[i] + can_use;
            c += new_a;
        } else {
            break;
        }
    }

    cout << c << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) solve();

    return 0;
}
