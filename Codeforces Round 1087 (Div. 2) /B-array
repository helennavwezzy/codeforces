#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<long long> a(n);
    for (auto &x : a) cin >> x;

    for (int i = 0; i < n; i++) {
        vector<pair<long double, int>> events;
        int current_count = 0;

        for (int j = i + 1; j < n; j++) {
            if (a[i] == a[j]) continue;

            long double mid = ( (long double)a[i] + a[j] ) / 2.0;

            if (a[j] > a[i]) {
                // k > mid
                events.push_back({mid, +1});
            } else {
                // k < mid
                current_count++;
                events.push_back({mid, -1});
            }
        }

        sort(events.begin(), events.end(), [](auto &x, auto &y) {
            if (x.first == y.first) return x.second < y.second;
            return x.first < y.first;
        });

        int max_j = current_count;

        for (auto &e : events) {
            current_count += e.second;
            max_j = max(max_j, current_count);
        }

        cout << max_j << (i + 1 < n ? ' ' : '\n');
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) solve();

    return 0;
}
